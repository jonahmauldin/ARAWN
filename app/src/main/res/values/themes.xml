<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Activity-level theme referenced by AndroidManifest.xml. The actual
         Compose styling lives in MainActivity (ArawnTheme); this just gives the
         window a dark, edge-to-edge AMOLED-black base before Compose draws.

         Phase E: parent updated to Theme.AppCompat.DayNight.NoActionBar so
         MainActivity (now AppCompatActivity) is satisfied. Visual output is
         identical — the black window background hides the brief pre-Compose
         draw, and Compose's own dark theme drives all in-app colours. -->
    <style name="Theme.ARAWN" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
